# Memoria Environment Configuration
# Copy this file to .env and customize for your environment

# ==============================================================================
# Immich Integration (Optional)
# ==============================================================================
# If you want to automatically upload processed media to Immich, configure these
# variables. If not set, Immich features will be disabled automatically.

# Your Immich server URL (required for Immich uploads)
# IMMICH_INSTANCE_URL=https://your-immich-server.com

# Your Immich API key (required for Immich uploads)
# Get this from your Immich instance: User Settings > API Keys
# IMMICH_API_KEY=your_api_key_here

# Number of concurrent uploads to Immich (default: 4)
# Increase for faster uploads with good network, decrease if experiencing issues
# IMMICH_UPLOAD_CONCURRENCY=4

# Skip hash checking during upload (default: true for speed)
# Set to false to enable duplicate detection via hash checking
# IMMICH_SKIP_HASH=true

# Patterns to ignore during Immich upload (comma-separated globs)
# Default ignores "issues" and "needs matching" directories
# IMMICH_IGNORE_PATTERNS=**/issues/**,**/*matching/**

# ==============================================================================
# Processing Configuration
# ==============================================================================

# Directory for temporary preprocessing files (default: ../pre)
# Change this if you want to use a different location
# TEMP_DIR=../pre

# Keep temporary files after processing for debugging (default: false)
# Set to 1, true, or yes to preserve temp directories and files
# Useful for debugging preprocessing issues
# DISABLE_TEMP_CLEANUP=false

# ==============================================================================
# Cross-Processor Deduplication (Optional)
# ==============================================================================
# Enable this feature to identify and eliminate duplicate files across different
# platform exports. For example, a photo that exists in both Google Photos and
# Instagram will only be stored once. See docs/Global-Deduplication.md for details.

# Enable cross-processor deduplication (default: false)
# When enabled, Memoria will analyze all exports before processing and
# identify duplicates across platforms.
# CROSS_PROCESSOR_DEDUP=false

# Enable perceptual hashing for fuzzy matching (default: true)
# Catches re-encoded or slightly modified versions of the same file.
# DEDUP_USE_PERCEPTUAL=true

# Perceptual hash similarity threshold (default: 0.92, range: 0.0-1.0)
# Higher values require closer matches, reducing false positives.
# DEDUP_PERCEPTUAL_THRESHOLD=0.92

# Path to SQLite database for hash persistence (default: ~/.memoria/dedup.db)
# Stores hashes for incremental processing across runs.
# DEDUP_DATABASE_PATH=~/.memoria/dedup.db

# Max characters per source in ImageDescription (default: 250)
# DEDUP_DESC_MAX_PER_SOURCE=250

# Max total characters for ImageDescription field (default: 1500)
# DEDUP_DESC_MAX_TOTAL=1500

# Message content truncation length (default: 200)
# DEDUP_MSG_TRUNCATE=200

# ==============================================================================
# Notes
# ==============================================================================
# 
# - Command-line arguments override environment variables
# - Environment variables override .env file values
# - All Immich settings are optional - if not set, uploads are skipped
# - The Immich CLI must be installed separately: npm i -g @immich/cli

